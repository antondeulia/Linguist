generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique
  pass String

  exerciseProgresses ExerciseProgress[]
  unitProgresses UnitProgress[]
  trackProgresses TrackProgress[]

  @@map("users")
}

model Course {
  id String @id @default(uuid())

  name String
  sourceLang String 
  targetLang String

  tracks Track[]

  @@map("courses")
}

model Track {
  id String @id @default(uuid())

  name String
  courseId String @map("course_id")
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  units Unit[]
  progresses TrackProgress[]

  @@map("tracks")
}

model Unit {
  id String @id @default(uuid())

  name String?

  trackId String @map("track_id")
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  exercises Exercise[]
  progresses UnitProgress[]

  @@map("units")
}

model Exercise {
  id String @id @default(uuid())

  text String
  type ExerciseType
  sourceLang String 
  targetLang String 

  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  exerciseProgresses ExerciseProgress[]

  @@map("exercises")
}

model TrackProgress {
  id String @id @default(uuid())
  isCompleted Boolean @default(false)
  totalUnits Int @map("total_units")
  completedUnits Int @default(0) @map("completed_units")

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String @map("track_id")
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("track_progresses")
}

model UnitProgress {
  id String @id @default(uuid())
  isCompleted Boolean @default(false)
  totalExercises Int
  completedExercises Int @default(0)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_progresses")
}

model ExerciseProgress {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)
  
  semanticLevel Int?
  detectedLevel String?
  explanation String?

  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("exercise_progresses")
}

enum ExerciseType {
  fromSourceToTarget
  fromTargetToSource
}