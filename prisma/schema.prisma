generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique
  pass String

  @@map("users")
}

model Course {
  id String @id @default(uuid())

  name String

  sourceLang String
  targetLang String

  tracks Track[]

  @@map("courses")
}

model Track {
  id String @id @default(uuid())

  name String

  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  units Unit[]

  @@map("tracks")
}

model Unit {
  id String @id @default(uuid())

  name String?

  trackId String
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  exercises Exercise[]

  @@map("units")
}

model Exercise {
  id String @id @default(uuid())

  text String
  type ExerciseType

  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("exercises")
}

enum ExerciseType {
  fromSourceToTarget
  fromTargetToSource
}