generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique
  pass String

  userState UserState?

  sectionProgresses SectionProgress[]
  exerciseProgresses ExerciseProgress[]
  unitProgresses UnitProgress[]
  trackProgresses TrackProgress[]

  @@map("users")
}

model UserState {
  userId String @id @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme String?
  currentCourseId String?
  currentSectionId String?
  currentUnitId String?

  @@map("user_states")
}

model Course {
  id String @id @default(uuid())

  name String
  sourceLang String 
  targetLang String

  sections Section[]

  @@map("courses")
}

model Section {
  id   String @id @default(uuid())
  name String
  courseId String @map("course_id")
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tracks Track[]
  progresses SectionProgress[]

  @@map("sections")
}

model Track {
  id String @id @default(uuid())
  name String

  sectionId String @map("section_id")
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  units Unit[]
  progresses TrackProgress[]

  @@map("tracks")
}

model Unit {
  id String @id @default(uuid())

  name String?

  trackId String @map("track_id")
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  exercises Exercise[]
  progresses UnitProgress[]

  @@map("units")
}

model Exercise {
  id String @id @default(uuid())

  rawText String
  type String
  sourceLang String 
  targetLang String
  direction String
  segments TextSegment[]

  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  exerciseProgresses ExerciseProgress[]

  @@map("exercises")
}

model TextSegment {
  id String @id @default(uuid())
  text String
  translation String
  hover Boolean
  
  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("text_segments")
}

// Progresses
model SectionProgress {
  id String @id @default(uuid())
  isCompleted Boolean @default(false) @map("is_completed")

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("section_progresses")
}

model TrackProgress {
  id String @id @default(uuid())
  isCompleted Boolean @default(false)
  totalUnits Int @map("total_units")
  completedUnits Int @default(0) @map("completed_units")

  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trackId String @map("track_id")
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("track_progresses")
}

model UnitProgress {
  id String @id @default(uuid())
  isCompleted Boolean @default(false)
  totalExercises Int
  completedExercises Int @default(0)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_progresses")
}

model ExerciseProgress {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)
  
  semanticLevel Int?
  detectedLevel String?
  explanation String?

  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("exercise_progresses")
}

enum ExerciseType {
  fromSourceToTarget
  fromTargetToSource
}